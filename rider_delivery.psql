
-- =====================================================
-- MEDEX - MODULE 6: RIDER AND DELIVERY MANAGEMENT
-- STANDALONE VERSION FOR TEMPORARY SUPABASE PROJECT
--
-- External dependencies intentionally not connected yet:
-- public.users
-- public.orders
--
-- These relationships must be connected by the team
-- when all modules are combined.
-- =====================================================


-- 1. RIDER PROFILES
CREATE TABLE IF NOT EXISTS public.rider_profiles (
    user_id UUID PRIMARY KEY,
    vehicle_type VARCHAR(50) NOT NULL,
    plate_number VARCHAR(30) NOT NULL,
    license_number VARCHAR(50),
    license_expiry_date DATE,
    contact_number VARCHAR(20),
    is_available BOOLEAN DEFAULT FALSE,
    approval_status VARCHAR(20) NOT NULL
        CHECK (approval_status IN ('Pending', 'Approved', 'Rejected', 'Suspended')),
    approved_by UUID,
    approved_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- 2. DELIVERIES
CREATE TABLE IF NOT EXISTS public.deliveries (
    delivery_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id UUID NOT NULL UNIQUE,
    rider_id UUID REFERENCES public.rider_profiles(user_id),
    delivery_number VARCHAR(30) NOT NULL UNIQUE,
    status VARCHAR(30) NOT NULL DEFAULT 'requested'
        CHECK (status IN (
            'requested',
            'assigned',
            'picked_up',
            'delivered',
            'not_home',
            'Failed'
        )),
    pickup_address TEXT,
    delivery_address TEXT NOT NULL,
    delivery_fee NUMERIC(10,2) NOT NULL CHECK (delivery_fee >= 0),
    confirmation_code_hash TEXT NOT NULL,
    assigned_at TIMESTAMPTZ,
    picked_up_at TIMESTAMPTZ,
    delivered_at TIMESTAMPTZ,
    failure_reason TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- 3. DELIVERY OFFERS
CREATE TABLE IF NOT EXISTS public.delivery_offers (
    offer_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id UUID NOT NULL
        REFERENCES public.deliveries(delivery_id) ON DELETE CASCADE,
    rider_id UUID NOT NULL
        REFERENCES public.rider_profiles(user_id),
    status VARCHAR(20) NOT NULL
        CHECK (status IN ('offered', 'accepted', 'declined', 'expired')),
    offered_at TIMESTAMPTZ DEFAULT NOW(),
    expires_at TIMESTAMPTZ NOT NULL,
    responded_at TIMESTAMPTZ,
    UNIQUE (delivery_id, rider_id)
);


-- 4. DELIVERY STATUS HISTORY
CREATE TABLE IF NOT EXISTS public.delivery_status_history (
    history_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id UUID NOT NULL
        REFERENCES public.deliveries(delivery_id) ON DELETE CASCADE,
    previous_status VARCHAR(30) NOT NULL,
    new_status VARCHAR(30) NOT NULL,
    changed_by UUID,
    created_at TIMESTAMPTZ DEFAULT NOW()
);


-- 5. RIDER LOCATIONS
CREATE TABLE IF NOT EXISTS public.rider_locations (
    location_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rider_id UUID NOT NULL
        REFERENCES public.rider_profiles(user_id),
    delivery_id UUID NOT NULL
        REFERENCES public.deliveries(delivery_id) ON DELETE CASCADE,
    recorded_at TIMESTAMPTZ DEFAULT NOW()
);


-- 6. RIDER EARNINGS
CREATE TABLE IF NOT EXISTS public.rider_earnings (
    earning_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rider_id UUID NOT NULL
        REFERENCES public.rider_profiles(user_id),
    delivery_id UUID NOT NULL UNIQUE
        REFERENCES public.deliveries(delivery_id),
    amount NUMERIC(10,2) NOT NULL CHECK (amount >= 0),
    status VARCHAR(20) NOT NULL
        CHECK (status IN ('pending', 'paid')),
    paid_at TIMESTAMPTZ,
    payment_reference VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT NOW()
);


-- 7. RIDER RATINGS
CREATE TABLE IF NOT EXISTS public.rider_ratings (
    rating_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    delivery_id UUID NOT NULL UNIQUE
        REFERENCES public.deliveries(delivery_id),
    rating SMALLINT NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- =====================================================
-- INDEXES
-- =====================================================

CREATE INDEX IF NOT EXISTS idx_deliveries_rider_id
ON public.deliveries(rider_id);

CREATE INDEX IF NOT EXISTS idx_deliveries_status
ON public.deliveries(status);

CREATE INDEX IF NOT EXISTS idx_delivery_offers_rider_id
ON public.delivery_offers(rider_id);

CREATE INDEX IF NOT EXISTS idx_delivery_history_delivery_id
ON public.delivery_status_history(delivery_id);

CREATE INDEX IF NOT EXISTS idx_rider_locations_delivery_id
ON public.rider_locations(delivery_id);

CREATE INDEX IF NOT EXISTS idx_rider_earnings_rider_id
ON public.rider_earnings(rider_id);

CREATE INDEX IF NOT EXISTS idx_rider_ratings_delivery_id
ON public.rider_ratings(delivery_id);


-- =====================================================
-- END OF MODULE 6 STANDALONE SCHEMA
-- =====================================================
